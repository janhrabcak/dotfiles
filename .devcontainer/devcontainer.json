{
  "name": "Dotfiles Sandbox & Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "timonwong.shellcheck"
      ]
    }
  },
  "postCreateCommand": "ln -sfn \"${containerWorkspaceFolder}\" \"$HOME/.dotfiles\" && zsh \"$HOME/.dotfiles/dot.sh\" --mode linux-client --install-deps",
  "remoteUser": "vscode"
}
