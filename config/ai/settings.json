{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "permissions": {
    "autoApprove": [
      "readFile",
      "listFiles",
      "searchFiles",
      "fetchWebPage"
    ],
    "requireConfirmation": [
      "writeFile",
      "editFile",
      "deleteFile",
      "executeCommand"
    ],
    "bash": {
      "autoApprovePatterns": [
        "^ls(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^cat(\\s+[a-zA-Z0-9_./@~:= -]+)+$",
        "^grep(\\s+[a-zA-Z0-9_./@~:= -]+)+$",
        "^rg(\\s+[a-zA-Z0-9_./@~:= -]+)+$",
        "^head(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^tail(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^tree(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^wc(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^file(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^stat(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^which(\\s+[a-zA-Z0-9_./@~:= -]+)+$",
        "^whereis(\\s+[a-zA-Z0-9_./@~:= -]+)+$",
        "^uname(\\s+-[a-zA-Z]+)*$",
        "^pwd$",
        "^git status(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git diff(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git log(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git branch(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git show(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git rev-parse(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git remote(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^git tag(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^node (-v|--version)$",
        "^npm (-v|--version|view|show|list)(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^go (version|env)$",
        "^python3? (-V|--version)$",
        "^pip (list|show)(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^docker ps(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^docker logs(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^docker (inspect|images)(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^docker-compose (ps|logs)(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^npm (test|run test)(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^go test(\\s+[a-zA-Z0-9_./@~:= -]+)*$",
        "^\\./dot\\.sh (--doctor|--dry-run|--test)$"
      ]
    }
  }
}
