# Personal identity lives in config/git/.gitconfig.local (gitignored).
# Copy config/git/.gitconfig.local.example → config/git/.gitconfig.local and fill in your details.
[include]
	path = ~/.dotfiles/config/git/.gitconfig.local

[core]
	editor = vim
	autocrlf = input
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = !gitk
