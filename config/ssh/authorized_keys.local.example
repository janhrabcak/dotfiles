# config/ssh/authorized_keys.local — machine-specific public keys (gitignored)
# Copy this file to config/ssh/authorized_keys.local and append authorized public keys:
#
#   cp config/ssh/authorized_keys.local.example config/ssh/authorized_keys.local
#   echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@example.com" >> config/ssh/authorized_keys.local

