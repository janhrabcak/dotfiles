#!/usr/bin/env zsh
# ==============================================================================
# Git Pre-commit Hook
# Single source of truth for pure-Zsh static syntax, JSON, SVG, link & secret checks.
# ==============================================================================
set -eo pipefail
setopt multibyte

REPO_ROOT="$(git -C "${0:A:h}" rev-parse --show-toplevel 2>/dev/null || echo "${0:A:h:h}")"
SECRETS_ONLY=false
[[ "${1:-}" == "--secrets-only" ]] && SECRETS_ONLY=true

if [[ "$SECRETS_ONLY" == "false" ]]; then
echo "🔍 Running pre-commit validation..."

# 1. Zsh syntax check
echo "  [1/5] Checking Zsh script syntax..."
zsh -n "$REPO_ROOT/dot.sh" \
       "$REPO_ROOT/config/zsh/.zshrc" \
       "$REPO_ROOT/config/zsh/aliases.zsh" \
       "$REPO_ROOT/.githooks/pre-commit" \
       "$REPO_ROOT/.githooks/pre-push" \
       "$REPO_ROOT/tests/run-tests.sh"

# 2. Tmux syntax check (isolated socket to protect active user sessions)
if command -v tmux >/dev/null 2>&1; then
  echo "  [2/5] Checking Tmux configuration..."
  tmux -L "dotfiles-precommit-$$" -f "$REPO_ROOT/config/tmux/.tmux.conf" start-server \; kill-server 2>/dev/null || {
    echo "❌ Tmux configuration check failed." >&2
    exit 1
  }
fi

# 3. Vim syntax check
if command -v vim >/dev/null 2>&1; then
  echo "  [3/5] Checking Vim configuration..."
  vim_tmp_home="$(mktemp -d)"
  HOME="$vim_tmp_home" vim -u "$REPO_ROOT/config/vim/.vimrc" -e -s -c "q" >/dev/null 2>&1 || {
    rm -rf "$vim_tmp_home"
    echo "❌ Vim configuration check failed." >&2
    exit 1
  }
  rm -rf "$vim_tmp_home"
fi

# 4. JSON schemas, iTerm2 Dynamic Profiles, SVG assets & AI Skill links
echo "  [4/5] Checking JSON schemas, SVG assets, and AI skill links..."
json_files=(
  "$REPO_ROOT/config/ai/settings.json"
  "$REPO_ROOT/config/ai/mcp_config.json"
  "$REPO_ROOT/.devcontainer/devcontainer.json"
  "$REPO_ROOT/config/iterm2/profiles.json"
)
if command -v jq >/dev/null 2>&1; then
  jq empty "${json_files[@]}" >/dev/null
  jq -e '(.Profiles | length >= 3) and (.Profiles | all(has("Guid") and has("Name")))' \
    "$REPO_ROOT/config/iterm2/profiles.json" >/dev/null || {
    echo "❌ Expected >=3 valid profiles with Guid/Name in config/iterm2/profiles.json" >&2
    exit 1
  }
else
  echo "  ⚠️  jq not installed; skipping strict JSON parse check."
fi

if grep -q '/Users/' "$REPO_ROOT/config/iterm2/profiles.json"; then
  echo "❌ Hardcoded /Users/ path found in config/iterm2/profiles.json" >&2
  exit 1
fi

for svg in "$REPO_ROOT"/assets/*.svg(N); do
  svg_data="$(<"$svg")"
  if [[ "$svg_data" != *"<svg"* || "$svg_data" != *"</svg>"* ]]; then
    echo "❌ Malformed SVG container in ${svg:t}" >&2
    exit 1
  fi
  if [[ "$svg_data" == *[$'\ue000'-$'\uf8ff']* ]]; then
    echo "❌ Private Use Area glyph detected in ${svg:t}" >&2
    exit 1
  fi
done
if command -v xmllint >/dev/null 2>&1; then
  xmllint --noout "$REPO_ROOT"/assets/*.svg >/dev/null
fi

for skill_md in "$REPO_ROOT"/config/ai/skills/**/*.md(N); do
  fence_char=""
  fence_len=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if (( fence_len > 0 )); then
      if [[ "$line" =~ "^[[:space:]]*${fence_char}{${fence_len},}[[:space:]]*$" ]]; then
        fence_char=""
        fence_len=0
      fi
      continue
    elif [[ "$line" =~ '^[[:space:]]*(`{3,}|~{3,})' ]]; then
      fence_char="${match[1][1]}"
      fence_len=${#match[1]}
      continue
    fi
    clean_line="$line"
    while [[ "$clean_line" =~ '`+[^`]+`+' ]]; do
      clean_line="${clean_line//$MATCH/}"
    done
    rest="$clean_line"
    while [[ "$rest" =~ '\[[^]]+\]\(([^)[:space:]]+)\)' ]]; do
      target="${match[1]}"
      rest="${rest#*$MATCH}"
      [[ "${target[1]}" == "#" || "$target" =~ '^[a-zA-Z][a-zA-Z0-9+.-]*:' ]] && continue
      rel_path="${target%%#*}"
      if [[ -n "$rel_path" && ! -e "${skill_md:h}/$rel_path" ]]; then
        echo "❌ Broken relative link in $skill_md: $target" >&2
        exit 1
      fi
    done
  done < "$skill_md"
done
fi

# 5. Pure-Zsh Secret & Internal Hostname Scanner (staged files or all tracked files)
echo "  [5/5] Scanning for leaked secrets, private keys, and internal hostnames..."
scan_files=()
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  staged=("${(@f)$(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)}")
  for f in "${staged[@]}"; do
    [[ -n "$f" ]] && scan_files+=("$f")
  done
  if (( ${#scan_files[@]} == 0 )); then
    tracked=("${(@f)$(git -C "$REPO_ROOT" ls-files 2>/dev/null || true)}")
    for f in "${tracked[@]}"; do
      [[ -n "$f" ]] && scan_files+=("$f")
    done
  fi
fi

secret_pattern='(-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----|(^|[^A-Za-z0-9_])(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|(^|[^A-Za-z0-9_])AKIA[0-9A-Z]{16}([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])AIza[0-9A-Za-z_-]{35}|(^|[^A-Za-z0-9_])sk-(proj-|ant-)?[A-Za-z0-9_-]{20,}|corp\.google\.com)'
secret_hits=0
for rel_f in "${scan_files[@]}"; do
  case "$rel_f" in
    .githooks/pre-commit|tests/run-tests.sh) continue ;;
  esac
  full_f="$REPO_ROOT/$rel_f"
  [[ -f "$full_f" ]] || continue
  if grep -InE "$secret_pattern" "$full_f" >/dev/null 2>&1; then
    echo "❌ Potential secret or internal hostname detected in $rel_f:" >&2
    grep -InE "$secret_pattern" "$full_f" | sed 's/^/     /' >&2
    secret_hits=$((secret_hits + 1))
  fi
done
if (( secret_hits > 0 )); then
  echo "❌ Secret scan failed ($secret_hits file(s) flagged). Remove sensitive material before committing." >&2
  exit 1
fi

echo "✅ All pre-commit checks passed!"
