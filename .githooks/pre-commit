#!/usr/bin/env zsh
# ==============================================================================
# Git Pre-commit Hook
# Validates shell script syntax and configuration integrity prior to commit.
# ==============================================================================
set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "🔍 Running pre-commit validation..."

# 1. Zsh syntax check
echo "  [1/3] Checking Zsh script syntax..."
zsh -n "$REPO_ROOT/dot.sh" \
       "$REPO_ROOT/config/zsh/.zshrc" \
       "$REPO_ROOT/config/zsh/aliases.zsh" \
       "$REPO_ROOT/.githooks/pre-commit" \
       "$REPO_ROOT/tests/run-tests.sh"

# 2. Tmux syntax check
if command -v tmux >/dev/null 2>&1; then
  echo "  [2/3] Checking Tmux configuration..."
  tmux -L "dotfiles-precommit-$$" -f "$REPO_ROOT/config/tmux/.tmux.conf" start-server \; kill-server 2>/dev/null || {
    echo "❌ Tmux configuration check failed." >&2
    exit 1
  }
fi

# 3. Vim syntax check
if command -v vim >/dev/null 2>&1; then
  echo "  [3/3] Checking Vim configuration..."
  vim_tmp_home="$(mktemp -d)"
  HOME="$vim_tmp_home" vim -u "$REPO_ROOT/config/vim/.vimrc" -e -s -c "q" >/dev/null 2>&1 || {
    rm -rf "$vim_tmp_home"
    echo "❌ Vim configuration check failed." >&2
    exit 1
  }
  rm -rf "$vim_tmp_home"
fi

echo "✅ All pre-commit checks passed!"
