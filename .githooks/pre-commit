#!/usr/bin/env zsh
# ==============================================================================
# Git Pre-commit Hook
# Single source of truth for static syntax, schema, and asset integrity checks.
# ==============================================================================
set -eo pipefail

REPO_ROOT="$(git -C "${0:A:h}" rev-parse --show-toplevel 2>/dev/null || echo "${0:A:h:h}")"

echo "🔍 Running pre-commit validation..."

# 1. Zsh syntax check
echo "  [1/4] Checking Zsh script syntax..."
zsh -n "$REPO_ROOT/dot.sh" \
       "$REPO_ROOT/config/zsh/.zshrc" \
       "$REPO_ROOT/config/zsh/aliases.zsh" \
       "$REPO_ROOT/.githooks/pre-commit" \
       "$REPO_ROOT/.githooks/pre-push" \
       "$REPO_ROOT/tests/run-tests.sh"

# 2. Tmux syntax check (isolated socket to protect active user sessions)
if command -v tmux >/dev/null 2>&1; then
  echo "  [2/4] Checking Tmux configuration..."
  tmux -L "dotfiles-precommit-$$" -f "$REPO_ROOT/config/tmux/.tmux.conf" start-server \; kill-server 2>/dev/null || {
    echo "❌ Tmux configuration check failed." >&2
    exit 1
  }
fi

# 3. Vim syntax check
if command -v vim >/dev/null 2>&1; then
  echo "  [3/4] Checking Vim configuration..."
  vim_tmp_home="$(mktemp -d)"
  HOME="$vim_tmp_home" vim -u "$REPO_ROOT/config/vim/.vimrc" -e -s -c "q" >/dev/null 2>&1 || {
    rm -rf "$vim_tmp_home"
    echo "❌ Vim configuration check failed." >&2
    exit 1
  }
  rm -rf "$vim_tmp_home"
fi

# 4. JSON, iTerm2 Dynamic Profiles, SVG XML/PUA, Python AST & Skill Links
if command -v python3 >/dev/null 2>&1; then
  echo "  [4/4] Checking JSON schemas, SVG assets, and AI skill integrity..."
  python3 - "$REPO_ROOT" << 'PYEOF'
import ast
import json
import pathlib
import re
import sys
import xml.etree.ElementTree as ET

root = pathlib.Path(sys.argv[1])

for rel_json in [
    "config/ai/settings.json",
    "config/ai/mcp_config.json",
    ".devcontainer/devcontainer.json",
    "config/iterm2/profiles.json",
]:
    p = root / rel_json
    data = json.loads(p.read_text(encoding="utf-8"))
    if rel_json == "config/iterm2/profiles.json":
        profiles = data.get("Profiles", [])
        assert len(profiles) >= 3, "Expected >=3 iTerm2 dynamic profiles"
        assert "/Users/" not in p.read_text(encoding="utf-8"), "Hardcoded /Users/ path in profiles.json"

for svg in sorted((root / "assets").glob("*.svg")):
    raw = svg.read_text(encoding="utf-8")
    ET.fromstring(raw)
    assert not any(0xE000 <= ord(c) <= 0xF8FF for c in raw), f"PUA glyph in {svg.name}"

for py_file in sorted((root / "config/ai/skills").rglob("*.py")):
    ast.parse(py_file.read_text(encoding="utf-8"), filename=str(py_file))

fence_re = re.compile(r"```.*?```", re.DOTALL)
inline_re = re.compile(r"`+[^`]+`+")
link_re = re.compile(r"\[[^\]]+\]\(([^)\s]+)\)")
for skill_md in sorted((root / "config/ai/skills").rglob("SKILL.md")):
    prose = inline_re.sub("", fence_re.sub("", skill_md.read_text(encoding="utf-8")))
    for target in link_re.findall(prose):
        if target.startswith("#") or re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", target):
            continue
        rel_path = target.split("#", 1)[0]
        if rel_path and not (skill_md.parent / rel_path).exists():
            raise AssertionError(f"Broken relative link in {skill_md}: {target}")
PYEOF
fi

echo "✅ All pre-commit checks passed!"
