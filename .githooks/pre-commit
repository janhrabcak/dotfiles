#!/usr/bin/env zsh
# ==============================================================================
# Git Pre-commit Hook
# Validates shell script syntax and configuration integrity prior to commit.
# ==============================================================================
set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "🔍 Running pre-commit validation..."

# 1. Zsh syntax check
echo "  [1/4] Checking Zsh script syntax..."
zsh -n "$REPO_ROOT/dot.sh" \
       "$REPO_ROOT/config/zsh/.zshrc" \
       "$REPO_ROOT/config/zsh/aliases.zsh" \
       "$REPO_ROOT/.githooks/pre-commit" \
       "$REPO_ROOT/tests/run-tests.sh"

# 2. Tmux syntax check
if command -v tmux >/dev/null 2>&1; then
  echo "  [2/4] Checking Tmux configuration..."
  tmux -f "$REPO_ROOT/config/tmux/.tmux.conf" start-server \; kill-server 2>/dev/null || {
    echo "❌ Tmux configuration check failed." >&2
    exit 1
  }
fi

# 3. Vim syntax check
if command -v vim >/dev/null 2>&1; then
  echo "  [3/4] Checking Vim configuration..."
  HOME="$REPO_ROOT" vim -u "$REPO_ROOT/config/vim/.vimrc" -e -s -c "q" >/dev/null 2>&1 || {
    echo "❌ Vim configuration check failed." >&2
    exit 1
  }
fi

# 4. ShellCheck static analysis (if installed)
if command -v shellcheck >/dev/null 2>&1; then
  echo "  [4/4] Running ShellCheck on test scripts..."
  shellcheck -s bash "$REPO_ROOT/tests/dot-local-ci-test.sh" "$REPO_ROOT/tests/test-vim.sh"
fi

echo "✅ All pre-commit checks passed!"
